if SHIELD_TOUCAN_LEFT

config ZMK_KEYBOARD_NAME
	default "Toucan"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
	default y

# Fetch for the gem L/R chips only. PROXY publishes a second BAS that Windows
# often treats as "the" battery; ZMK writes 0% on split disconnect, which makes
# the tray jump to 0% during brief right-half flaps.
config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
	default n

endif

if SHIELD_TOUCAN_LEFT || SHIELD_TOUCAN_RIGHT

config SPI
	default y

config ZMK_SPLIT
	default y

config ZMK_POINTING
	default y

config RGBLED_WIDGET_BATTERY_LEVEL_HIGH
	default 40

endif
